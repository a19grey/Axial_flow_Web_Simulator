{
  "name": "axial-flow-web-simulator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Client-side WebGPU magnetostatic field solver and design test bed for axial-flux machines.",
  "license": "MIT",
  "scripts": {
    "start": "node cli/serve.js",
    "test": "node tests/run-tests.js",
    "test:quick": "node tests/run-tests.js --only analytic && node tests/study.js --cpu-only && node tests/metrics.js --cpu-only && node tests/run-tests.js --only ui",
    "test:analytic": "node tests/run-tests.js --only analytic",
    "test:reference": "node tests/run-tests.js --only reference",
    "test:ui": "node tests/run-tests.js --only ui",
    "test:convergence": "node tests/run-tests.js --only convergence",
    "setup": "npm install && npx playwright install chromium",
    "cli": "node cli/run.js",
    "solve": "node cli/run.js solve",
    "plan": "node cli/run.js plan",
    "capabilities": "node cli/run.js capabilities",
    "test:metrics": "node tests/run-tests.js --only metrics",
    "test:geometry": "node tests/run-tests.js --only geometry",
    "test:study": "node tests/run-tests.js --only study",
    "test:agent-entry": "node tests/run-tests.js --only agent-entry",
    "study": "node cli/study.js run",
    "frames": "node cli/frames.js",
    "runs": "node cli/study.js list"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
